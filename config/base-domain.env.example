# Single source of truth for public simulator hostnames.
# Keep this aligned with smart-router-standalone/values/core/values.yml: base_domain
#
# base-domain.env is PER-SERVER and NOT tracked in git. Copy this file to
# base-domain.env in the same directory and set your own tenant domain.
# scripts/deploy.sh reads base-domain.env; keeping it untracked means the
# self-update guard never overwrites your tenant value with someone else's.
BASE_DOMAIN="<your-tenant>.magmadevs.com"
